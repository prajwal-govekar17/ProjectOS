PORT=3000
APP_ORIGIN=http://localhost:5173

# Runtime only. Set both DATABASE_URL and SESSION_SECRET to enable the database-backed API.
# DATABASE_URL=postgresql://projectos_runtime:replace-me@db.example.invalid:5432/postgres
# DATABASE_CA_FILE=/absolute/path/to/supabase-ca.pem
# SESSION_SECRET=replace-me

# Put development operator variables in .env.migration.development.
# MIGRATION_DATABASE_URL=postgresql://projectos_migrator:replace-me@db.example.invalid:5432/postgres
# MIGRATION_DATABASE_NAME=postgres
# MIGRATION_DATABASE_ROLE=projectos_migrator
# DATABASE_CA_FILE=/absolute/path/to/supabase-ca.pem

# Put production operator variables in .env.migration.production.
# PRODUCTION_MIGRATION_DATABASE_URL=postgresql://projectos_migrator_prod:replace-me@db.example.invalid:5432/postgres
# PRODUCTION_MIGRATION_DATABASE_NAME=postgres
# PRODUCTION_MIGRATION_DATABASE_ROLE=projectos_migrator_prod
# PRODUCTION_DATABASE_CA_FILE=/absolute/path/to/supabase-ca.pem

# Put isolated test variables in .env.test or export them in your test shell.
# TEST_DATABASE_URL=postgresql://projectos_test_owner:replace-me@127.0.0.1:5432/projectos_test_local
# TEST_DATABASE_NAME=projectos_test_local
# TEST_DATABASE_ROLE=projectos_test_owner
# TEST_DATABASE_SCHEMA=projectos
# TEST_RUNTIME_DATABASE_URL=postgresql://projectos_test_runtime:replace-me@127.0.0.1:5432/projectos_test_local
# TEST_DATABASE_CA_FILE=/absolute/path/to/test-ca.pem
