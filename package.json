{
  "name": "projectos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^24.12.0",
    "npm": "^11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "lint": "eslint . && node scripts/check-structure.js",
    "format": "prettier --write \"{apps,packages,scripts,tests}/**/*.{ts,tsx,js,json}\" package.json tsconfig.base.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check \"{apps,packages,scripts,tests}/**/*.{ts,tsx,js,json}\" package.json tsconfig.base.json eslint.config.js .prettierrc.json",
    "pretypecheck": "npm run build --workspace @projectos/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tests/tsconfig.json",
    "pretest": "npm run build --workspace @projectos/api",
    "test": "node --test",
    "build": "npm run build --workspaces --if-present",
    "prestart": "npm run build",
    "start": "npm run start --workspace @projectos/api",
    "seed:demo": "node scripts/seed-demo.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.11.0",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
